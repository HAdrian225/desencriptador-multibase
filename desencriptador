#!/usr/bin/env bash
# Desencriptador por capas: muestra el archivo decodificado y deja seguir descifrando capa por capa
# (base64, base32, base58, hexadecimal, ROT13, UTF-16LE, gzip/zlib/deflate y XOR) hasta que el
# usuario decida parar o no quede nada reconocible. Nunca ejecuta el contenido: solo lo decodifica.
set -uo pipefail

ALFABETO58="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
# Palabras comunes (español/inglés) para reconocer texto descifrado con ROT13
PALABRAS='el|la|de|que|es|un|una|en|los|las|por|con|para|este|esta|texto|mensaje|clave|the|is|an|and|of|to|in|this|that|key|secure|message'
# Formatos de flag conocidos: también sirven para reconocer un ROT13 correcto
PATRON_FLAG='(HTB|flag|CTF|THM)\{'
# Formatos que se prueban sobre el contenido completo, en orden
FORMATOS=(hex base32 base64 base58 rot13)
# Formatos que se prueban en los bloques codificados dentro de un texto (ej: base64 dentro de un script)
FORMATOS_BLOQUES=(hex base32 base64)
# Largo mínimo de esos bloques
MIN_BLOQUE=16
# Un bloque que da binario solo se acepta si es así de largo (si no, suele ser una palabra cualquiera)
MIN_BINARIO=64
# Largos de hash en hexadecimal: no son texto cifrado, decodificarlos solo da bytes aleatorios
declare -A HASHES=([32]="MD5 o NTLM" [40]="SHA-1" [56]="SHA-224" [64]="SHA-256" [96]="SHA-384" [128]="SHA-512")
# Diccionarios que se buscan si no se indica uno al crackear un hash
DICCIONARIOS=(/usr/share/wordlists/rockyou.txt "$HOME/wordlists/rockyou.txt" /usr/share/john/password.lst)
# hashcat: modos para cada largo de hash, sus nombres y dónde están las reglas
declare -A HC_MODOS=([32]="0 1000" [40]="100" [56]="1300 17300" [64]="1400 17400" [96]="10800 17500" [128]="1700 17600")
declare -A HC_NOMBRES=([0]=MD5 [1000]=NTLM [100]=SHA-1 [1300]=SHA-224 [17300]=SHA3-224 [1400]=SHA-256 [17400]=SHA3-256
    [10800]=SHA-384 [17500]=SHA3-384 [1700]=SHA-512 [17600]=SHA3-512)
REGLAS_DIR=/usr/share/hashcat/rules

archivo=""
trabajo="$(mktemp -d)"
trap 'rm -rf "$trabajo"' EXIT
tmp="$trabajo/tmp"
tmp_look="$trabajo/look"

# Capas: CAPA_ARCH[i] tiene el contenido de la capa i (0 = archivo original); CAPA_DESC[i], cómo se obtuvo
CAPA_ARCH=()
CAPA_DESC=()
# Caracteres descartados al inicio de un base64 desalineado
DESCARTADOS=""
# Transformaciones aplicadas después de decodificar (UTF-16LE, gzip, zlib, deflate, XOR)
PASOS=()

# Pide un archivo hasta que exista (o el usuario cancele con Enter vacío si ya había uno)
elegir_archivo() {
    local ruta
    while true; do
        read -r -e -p "Ruta del archivo a desencriptar: " ruta || exit 0
        # Quitar comillas si se pegó la ruta entre comillas
        ruta="${ruta%\"}"; ruta="${ruta#\"}"; ruta="${ruta%\'}"; ruta="${ruta#\'}"
        # Quitar los escapes que agrega el autocompletado con Tab (ej: "mensaje\ base32.txt")
        ruta="$(printf '%s' "$ruta" | sed 's/\\\(.\)/\1/g')"
        # Expandir ~ al directorio personal
        [[ "$ruta" == "~/"* ]] && ruta="$HOME/${ruta:2}"
        if [ -z "$ruta" ] && [ -n "$archivo" ]; then
            return
        elif [ -f "$ruta" ]; then
            archivo="$ruta"
            return
        fi
        echo "Error: el archivo '$ruta' no existe." >&2
    done
}

# Nombre de salida: "<nombre> desencriptado.<ext>" en el mismo directorio ($1 fuerza otra extensión)
nombre_salida() {
    local ext="${1:-}" dir base
    dir="$(dirname -- "$archivo")"
    base="$(basename -- "$archivo")"
    if [ -n "$ext" ]; then
        echo "$dir/${base%.*} desencriptado.$ext"
    elif [[ "$base" == *.* ]]; then
        echo "$dir/${base%.*} desencriptado.${base##*.}"
    else
        echo "$dir/$base desencriptado"
    fi
}

# Base58 (alfabeto Bitcoin) -> hexadecimal, usando bc para números grandes
base58_a_hex() {
    local s="$1" expr="obase=16;n=0;" c prefijo hex ceros="" i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        prefijo="${ALFABETO58%%"$c"*}"
        expr+="n=n*58+${#prefijo};"
    done
    hex="$(BC_LINE_LENGTH=0 bc <<< "${expr}n")"
    [ "$hex" = "0" ] && hex=""
    [ $(( ${#hex} % 2 )) -eq 1 ] && hex="0$hex"
    # Cada '1' inicial representa un byte 0x00
    while [ "${s:0:1}" = "1" ]; do ceros+="00"; s="${s:1}"; done
    printf '%s' "$ceros$hex"
}

# Cuenta palabras comunes en un texto
contar_palabras() {
    grep -oiwE "$PALABRAS" | wc -l
}

# El resultado tiene que ser texto legible: UTF-8 válido, sin caracteres de control y con alguna letra/número
es_texto() {
    local f="$1"
    [ -s "$f" ] || return 1
    iconv -f UTF-8 -t UTF-8 "$f" > /dev/null 2>&1 || return 1
    LC_ALL=C tr -d '\t\n\r' < "$f" | LC_ALL=C grep -aq '[[:cntrl:]]' && return 1
    grep -q '[[:alnum:]]' "$f" || return 1
    # Al menos el 90 % tienen que ser letras, números, espacios o puntuación
    local total buenos
    total="$(grep -o . "$f" | wc -l)"
    buenos="$(grep -o '[[:alnum:][:space:][:punct:]]' "$f" | wc -l)"
    [ $((buenos * 10)) -ge $((total * 9)) ]
}

# Primeros $2 bytes de un archivo en hexadecimal
hex_inicio() {
    head -c "$2" "$1" | xxd -p | tr -d '\n'
}

# Decodifica un bloque tal cual en el archivo destino, sin exigir que dé texto
# (ROT13 sí se valida, porque cualquier texto "se decodifica" con ROT13)
decodificar() {
    local tipo="$1" bloque="$2" destino="$3" limpio off t rotado
    case "$tipo" in
        base64)
            limpio="$(printf '%s' "$bloque" | tr -d '[:space:]')"
            [[ "$limpio" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || return 1
            # Si hay basura al inicio el bloque queda desalineado: descartar 1 a 3 caracteres
            for off in 0 1 2 3; do
                t="${limpio:off}"
                [ $(( ${#t} % 4 )) -eq 0 ] || continue
                printf '%s' "$t" | base64 -d > "$destino" 2>/dev/null || return 1
                DESCARTADOS="${limpio:0:off}"
                break
            done ;;
        base32)
            limpio="$(printf '%s' "$bloque" | tr -d '[:space:]')"
            [[ "$limpio" =~ ^[A-Z2-7]+={0,6}$ ]] && [ $(( ${#limpio} % 8 )) -eq 0 ] || return 1
            printf '%s' "$limpio" | base32 -d > "$destino" 2>/dev/null || return 1 ;;
        base58)
            limpio="$(printf '%s' "$bloque" | tr -d '[:space:]')"
            [[ "$limpio" =~ ^[$ALFABETO58]{6,}$ ]] || return 1
            base58_a_hex "$limpio" | xxd -r -p > "$destino" 2>/dev/null || return 1 ;;
        hex)
            # Acepta "48656c", "48 65 6c", "48:65:6c", "0x48 0x65" y "\x48\x65"
            limpio="$(printf '%s' "$bloque" | sed -E 's/0[xX]([0-9a-fA-F]{2})/\1/g; s/\\x//g' | tr -d ' \t\r\n:,')"
            [[ "$limpio" =~ ^([0-9a-fA-F]{2})+$ ]] || return 1
            printf '%s' "$limpio" | xxd -r -p > "$destino" 2>/dev/null || return 1 ;;
        rot13)
            printf '%s' "$bloque" | tr 'A-Za-z' 'N-ZA-Mn-za-m' > "$destino"
            es_texto "$destino" || return 1
            # Solo se acepta si quedan más palabras reconocibles, si aparece una flag
            # o si el resultado se puede seguir decodificando
            [ "$(contar_palabras < "$destino")" -gt "$(printf '%s' "$bloque" | contar_palabras)" ] && return 0
            if grep -qiE "$PATRON_FLAG" "$destino" && ! printf '%s' "$bloque" | grep -qiE "$PATRON_FLAG"; then
                return 0
            fi
            rotado="$(cat "$destino")"
            a_texto hex "$rotado" || a_texto base32 "$rotado" || a_texto base64 "$rotado" || return 1
            DESCARTADOS=""
            return 0 ;;
    esac
    [ -s "$destino" ]
}

# Decodifica y exige texto legible, sin tocar $tmp (para mirar una capa más adelante)
a_texto() {
    decodificar "$1" "$2" "$tmp_look" && es_texto "$tmp_look"
}

# ¿Parece UTF-16LE (ej: PowerShell -EncodedCommand)? BOM FF FE o casi todos los bytes impares en cero
es_utf16le() {
    [ "$(hex_inicio "$1" 2)" = fffe ] && return 0
    head -c 400 "$1" | xxd -p -c1 | awk '
        NR % 2 == 0 { n++; if ($0 != "00") malos++ }
        NR % 2 == 1 && $0 == "00" { ceros++ }
        END { exit !(n >= 2 && malos * 10 <= n && ceros * 2 < n) }'
}

# Convierte el archivo de UTF-16LE a UTF-8 (sin BOM)
a_utf8() {
    iconv -f UTF-16LE -t UTF-8 "$1" 2>/dev/null | sed '1s/^\xEF\xBB\xBF//' > "$1.nuevo" && [ -s "$1.nuevo" ] \
        && mv -- "$1.nuevo" "$1"
}

# Descomprime el archivo en el lugar: $1 = gzip, zlib o deflate (crudo, el de DeflateStream)
inflar() {
    local modo="$1" f="$2"
    if [ "$modo" = gzip ]; then
        gzip -dc < "$f" > "$f.nuevo" 2>/dev/null
    else
        python3 -I -c 'import sys, zlib
w = 15 if sys.argv[1] == "zlib" else -15
sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read(), w))' "$modo" < "$f" > "$f.nuevo" 2>/dev/null
    fi
    [ $? -eq 0 ] && [ -s "$f.nuevo" ] && mv -- "$f.nuevo" "$f"
}

# Clave XOR escrita como "35" o "0x23" -> número
valor_clave() {
    case "$1" in
        0x*|0X*) echo $((16#${1:2})) ;;
        *) echo $((10#$1)) ;;
    esac
}

clave_valida() {
    [[ "$1" =~ ^(0[xX][0-9a-fA-F]{1,2}|[0-9]{1,3})$ ]] && [ "$(valor_clave "$1")" -le 255 ]
}

# Aplica XOR con una clave de un byte al archivo, en el lugar
aplicar_xor() {
    python3 -I -c 'import sys
k = int(sys.argv[1]); p = sys.argv[2]
d = open(p, "rb").read()
open(p, "wb").write(bytes(b ^ k for b in d))' "$(valor_clave "$1")" "$2"
}

# Después de decodificar: deshace UTF-16LE, compresión y XOR. Las pistas salen del texto de origen
# ($2): "-bxor 35" da la clave XOR y "DeflateStream" indica deflate crudo. Deja lo aplicado en PASOS.
posprocesar() {
    local f="$1" origen="$2" clave deflate=0 i magia
    PASOS=()
    clave="$(LC_ALL=C grep -aoiE -- '-bxor[[:space:]]*(0x[0-9a-f]+|[0-9]+)' "$origen" | head -n 1 \
        | grep -oiE '(0x[0-9a-f]+|[0-9]+)$')"
    clave_valida "$clave" || clave=""
    LC_ALL=C grep -aqi 'DeflateStream' "$origen" && deflate=1
    for i in 1 2 3 4 5 6; do
        magia="$(hex_inicio "$f" 2)"
        if [ "$magia" = 1f8b ] && inflar gzip "$f"; then
            PASOS+=(gzip)
        elif [[ "$magia" =~ ^78(01|5e|9c|da)$ ]] && inflar zlib "$f"; then
            PASOS+=(zlib)
        elif es_texto "$f"; then
            break
        elif es_utf16le "$f" && a_utf8 "$f"; then
            PASOS+=(UTF-16LE)
        elif [ "$deflate" = 1 ] && inflar deflate "$f"; then
            deflate=0
            PASOS+=(deflate)
        elif [ -n "$clave" ]; then
            aplicar_xor "$clave" "$f"
            PASOS+=("XOR $clave")
            clave=""
        else
            break
        fi
    done
}

# Descripción de la capa recién decodificada: "base64 → gzip"
describir() {
    local d="$1" p
    for p in "${PASOS[@]}"; do d+=" → $p"; done
    [ -n "$DESCARTADOS" ] && d+=" (se descartaron ${#DESCARTADOS} caracter(es) iniciales no alineados: '$DESCARTADOS')"
    printf '%s' "$d"
}

# Intenta decodificar $2 como $1 en $tmp. Modo "texto": solo acepta texto legible.
# Modo "binario": acepta también binario si se reconoció algo (gzip, XOR...) o si el bloque es largo.
intentar() {
    local tipo="$1" bloque="$2" modo="$3" origen="$4"
    DESCARTADOS=""
    PASOS=()
    decodificar "$tipo" "$bloque" "$tmp" || return 1
    posprocesar "$tmp" "$origen"
    es_texto "$tmp" && return 0
    [ "$modo" = binario ] && [ "$tipo" != rot13 ] || return 1
    [ "${#PASOS[@]}" -gt 0 ] || [ "${#bloque}" -ge "$MIN_BINARIO" ]
}

agregar_capa() {
    CAPA_DESC+=("$1")
    CAPA_ARCH+=("$2")
}

# Si el archivo es solo un hash en hexadecimal, deja el tipo en HASH_TIPO y el valor en HASH_VALOR
detectar_hash() {
    HASH_VALOR="$(tr -d '[:space:]' < "$1")"
    HASH_TIPO=""
    [[ "$HASH_VALOR" =~ ^[0-9a-fA-F]+$ ]] && HASH_TIPO="${HASHES[${#HASH_VALOR}]:-}"
    [ -n "$HASH_TIPO" ]
}

# Ataque de diccionario contra el hash de la capa actual: prueba cada palabra con los algoritmos
# de ese largo (MD5/NTLM, SHA-1, SHA-224, SHA-256, SHA-384, SHA-512) y agrega la palabra como capa nueva
# Pide un diccionario (Enter = el primero de DICCIONARIOS que exista) y lo deja en DIC.
# Con $1 = "palabra" también acepta una palabra suelta en vez de un archivo.
pedir_diccionario() {
    local d r
    DIC=""
    for d in "${DICCIONARIOS[@]}"; do
        [ -f "$d" ] && { DIC="$d"; break; }
    done
    if [ "${1:-}" = palabra ]; then
        read -r -e -p "Diccionario o palabra a probar${DIC:+ [$DIC]}: " r || exit 0
    else
        read -r -e -p "Diccionario (una palabra por línea)${DIC:+ [$DIC]}: " r || exit 0
    fi
    r="${r%\"}"; r="${r#\"}"; r="${r%\'}"; r="${r#\'}"
    [[ "$r" == "~/"* ]] && r="$HOME/${r:2}"
    [ -n "$r" ] && DIC="$r"
    if [ -z "$DIC" ]; then
        echo "Error: no se indicó diccionario." >&2
        return 1
    elif [ "${1:-}" != palabra ] && [ ! -f "$DIC" ]; then
        echo "Error: el diccionario '$DIC' no existe." >&2
        return 1
    fi
}

# Pide un archivo de reglas de hashcat (nombre de /usr/share/hashcat/rules o ruta) y lo deja en REGLAS
pedir_reglas() {
    local r def=""
    for r in best66.rule best64.rule; do
        [ -f "$REGLAS_DIR/$r" ] && { def="$r"; break; }
    done
    read -r -e -p "Reglas (best66.rule, rockyou-30000.rule, dive.rule... o una ruta)${def:+ [$def]}: " r || exit 0
    r="${r:-$def}"
    [[ "$r" == "~/"* ]] && r="$HOME/${r:2}"
    if [ -f "$r" ]; then
        REGLAS="$r"
    elif [ -f "$REGLAS_DIR/$r" ]; then
        REGLAS="$REGLAS_DIR/$r"
    else
        echo "Error: no se encontró el archivo de reglas '$r'." >&2
        return 1
    fi
}

# Ataque de diccionario en Python, sin hashcat ($1 = diccionario o palabra). Deja la palabra en $2.
crackear_python() {
    local nuevo="$2" r
    [ -f "$1" ] && echo "Probando con '$1' (Ctrl+C para cancelar)..."
    # Ctrl+C corta solo el ataque, no el programa
    trap 'true' INT
    python3 -I -c '
import hashlib, sys, time
objetivo, ruta, salida = sys.argv[1].lower(), sys.argv[2], sys.argv[3]
algoritmos = {32: ["md5", "ntlm"], 40: ["sha1"], 56: ["sha224", "sha3_224"], 64: ["sha256", "sha3_256"],
              96: ["sha384", "sha3_384"], 128: ["sha512", "sha3_512"]}[len(objetivo)]
def funcion(nombre):
    if nombre == "ntlm":
        try:
            hashlib.new("md4")
        except ValueError:
            return None
        return lambda p: hashlib.new("md4", p.decode("utf-8", "replace").encode("utf-16-le")).hexdigest()
    return lambda p, n=nombre: hashlib.new(n, p).hexdigest()
def bonito(nombre):
    return {"md5": "MD5", "ntlm": "NTLM"}.get(nombre) or nombre.upper().replace("SHA3_", "SHA3-").replace("SHA", "SHA-", 1).replace("SHA-3-", "SHA3-")
pruebas = [(n, f) for n in algoritmos if (f := funcion(n))]
def palabras():
    try:
        with open(ruta, "rb") as d:
            for linea in d:
                yield linea.rstrip(b"\r\n")
    except (FileNotFoundError, IsADirectoryError):
        yield ruta.encode()
n, inicio = 0, time.time()
try:
    for p in palabras():
        n += 1
        for nombre, f in pruebas:
            if f(p) == objetivo:
                alg = bonito(nombre)
                texto = p.decode("utf-8", "replace")
                open(salida, "wb").write(p + b"\n")
                open(salida + ".alg", "w").write(alg)
                print(f"Encontrado con {alg} tras {n} palabra(s): {texto}")
                sys.exit(0)
        if n % 1000000 == 0:
            print(f"  {n:,} palabras probadas ({n / (time.time() - inicio):,.0f}/s)...", file=sys.stderr)
except KeyboardInterrupt:
    print(f"Cancelado tras {n:,} palabra(s).", file=sys.stderr)
    sys.exit(130)
usados = ", ".join(bonito(x) for x, _ in pruebas)
print(f"No se encontró: se probaron {n:,} palabra(s) con {usados}.", file=sys.stderr)
sys.exit(1)
' "$HASH_VALOR" "$1" "$nuevo"
    r=$?
    trap - INT
    [ "$r" -eq 0 ] || return 1
    HC_ALG="$(cat "$nuevo.alg")"
    rm -f -- "$nuevo.alg"
}

# Deja en $3 la palabra que encontró hashcat ($2) con el modo $1
hc_encontrado() {
    # hashcat escribe $HEX[...] cuando la palabra tiene caracteres no imprimibles
    if [[ "$2" =~ ^\$HEX\[([0-9a-fA-F]*)\]$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}" | xxd -r -p > "$3"
        echo >> "$3"
    else
        printf '%s\n' "$2" > "$3"
    fi
    HC_ALG="${HC_NOMBRES[$1]}"
    echo "Encontrado con $HC_ALG${HC_POTFILE:+ (ya estaba en el potfile de hashcat)}: $2"
}

# Ataque con hashcat (GPU): prueba cada modo que corresponde al largo del hash con los argumentos
# de ataque recibidos ($2...). $1 = archivo donde dejar la palabra. Los resultados quedan en el
# potfile de hashcat, así que un hash ya crackeado sale al instante.
crackear_hashcat() {
    local nuevo="$1" hashf="$trabajo/hash.txt" m plano r fallo=""
    # Sesión propia: hashcat no deja correr dos instancias con la misma sesión
    local -a opciones=(-O -w 3 --quiet --status --status-timer 30 --session "desencriptador_$$")
    shift
    printf '%s\n' "${HASH_VALOR,,}" > "$hashf"
    HC_POTFILE=""
    # Si ya se crackeó antes, está en el potfile de hashcat: no hace falta atacarlo de nuevo
    for m in ${HC_MODOS[${#HASH_VALOR}]}; do
        plano="$(hashcat -m "$m" --show --outfile-format 2 "$hashf" 2>/dev/null | head -n 1)"
        if [ -n "$plano" ]; then
            HC_POTFILE=1
            hc_encontrado "$m" "$plano" "$nuevo"
            return 0
        fi
    done
    # Ctrl+C (o q) corta solo el ataque, no el programa
    trap 'true' INT
    for m in ${HC_MODOS[${#HASH_VALOR}]}; do
        echo
        echo ">> hashcat ${HC_NOMBRES[$m]} (modo $m). Teclas: s = estado, q = cortar"
        # Sin terminal (ej: entrada por tubería) hashcat no tiene que leer teclas de stdin
        if [ -t 0 ]; then
            hashcat -m "$m" "${opciones[@]}" "$hashf" "$@"
        else
            hashcat -m "$m" "${opciones[@]}" "$hashf" "$@" < /dev/null
        fi
        # 0 = encontrado, 1 = agotado sin encontrar; otro código = error o cortado
        r=$?
        [ "$r" -gt 1 ] && fallo+=" ${HC_NOMBRES[$m]} (código $r)"
        plano="$(hashcat -m "$m" --show --outfile-format 2 "$hashf" 2>/dev/null | head -n 1)"
        if [ -n "$plano" ]; then
            trap - INT
            hc_encontrado "$m" "$plano" "$nuevo"
            return 0
        fi
    done
    trap - INT
    if [ -n "$fallo" ]; then
        echo "hashcat no terminó (error o cortado):$fallo. Revisá los mensajes de arriba." >&2
    else
        echo "No se encontró: hashcat agotó el ataque con$(for m in ${HC_MODOS[${#HASH_VALOR}]}; do printf ' %s' "${HC_NOMBRES[$m]}"; done)." >&2
    fi
    return 1
}

# Crackea el hash de la capa actual y agrega la palabra encontrada como capa nueva.
# Con hashcat: diccionario, diccionario + reglas, fuerza bruta o una palabra; sin hashcat, Python.
crackear() {
    local actual="${CAPA_ARCH[${#CAPA_ARCH[@]}-1]}" nuevo="$trabajo/capa${#CAPA_ARCH[@]}" metodo mascara desc
    if ! detectar_hash "$actual"; then
        echo "Error: la capa actual no es un hash (MD5, SHA-1, SHA-224, SHA-256, SHA-384 o SHA-512)." >&2
        return 1
    fi
    echo "Hash $HASH_TIPO: $HASH_VALOR"
    if command -v hashcat > /dev/null 2>&1; then
        echo "1) Diccionario   2) Diccionario + reglas   3) Fuerza bruta (máscara)   4) Probar una palabra"
        read -r -p "Método [1]: " metodo || exit 0
    else
        echo "(hashcat no está instalado: se usa un ataque de diccionario en Python, más lento)"
        metodo=python
    fi
    case "${metodo:-1}" in
        1)
            pedir_diccionario || return 1
            desc="hashcat, diccionario $(basename -- "$DIC")"
            crackear_hashcat "$nuevo" -a 0 "$DIC" || return 1 ;;
        2)
            pedir_diccionario || return 1
            pedir_reglas || return 1
            desc="hashcat, diccionario $(basename -- "$DIC") + reglas $(basename -- "$REGLAS")"
            crackear_hashcat "$nuevo" -a 0 -r "$REGLAS" "$DIC" || return 1 ;;
        3)
            echo "Máscara: ?l minúsculas, ?u mayúsculas, ?d dígitos, ?s símbolos, ?a todo. Prueba desde 1 carácter hasta el largo de la máscara."
            read -r -p "Máscara [?a?a?a?a?a?a]: " mascara || exit 0
            mascara="${mascara:-?a?a?a?a?a?a}"
            desc="hashcat, fuerza bruta $mascara"
            crackear_hashcat "$nuevo" -a 3 --increment "$mascara" || return 1 ;;
        4|python)
            HC_POTFILE=""
            pedir_diccionario palabra || return 1
            if [ -f "$DIC" ]; then desc="diccionario $(basename -- "$DIC")"; else desc="la palabra indicada"; fi
            crackear_python "$DIC" "$nuevo" || return 1 ;;
        *)
            echo "Opción inválida." >&2
            return 1 ;;
    esac
    [ -n "${HC_POTFILE:-}" ] && desc="hashcat, ya estaba en su potfile"
    agregar_capa "$HC_ALG crackeado con $desc" "$nuevo"
}

# Descifra una capa más del contenido actual y la agrega como capa nueva
siguiente_capa() {
    local actual="${CAPA_ARCH[${#CAPA_ARCH[@]}-1]}" nuevo="$trabajo/capa${#CAPA_ARCH[@]}"
    local contenido unicas modo tipo bloque desc="" n=0 i hash=""
    local -a bloques partes=()

    if ! es_texto "$actual"; then
        echo "Error: la capa actual es binaria, no hay texto codificado para seguir. Podés probar XOR (x) o guardarla (g)." >&2
        return 1
    fi
    # Si el archivo repite la misma línea, se decodifica una sola vez
    unicas="$(grep -v '^[[:space:]]*$' "$actual" | tr -d '\r' | awk '!visto[$0]++')"
    if [ "$(printf '%s\n' "$unicas" | wc -l)" -eq 1 ]; then
        contenido="$unicas"
    else
        contenido="$(cat "$actual")"
    fi
    [[ "$contenido" =~ ^[0-9a-fA-F]+$ ]] && hash="${HASHES[${#contenido}]:-}"
    # Bloques codificados dentro del texto, sin repetidos y del más largo al más corto
    mapfile -t bloques < <(LC_ALL=C grep -aoE "[A-Za-z0-9+/]{$MIN_BLOQUE,}={0,6}" "$actual" \
        | awk '!visto[$0]++ { print length($0) "\t" $0 }' | sort -rn -k1,1 | cut -f2-)

    for modo in texto binario; do
        # Un hash solo se acepta si da texto legible (casi nunca): no tiene sentido pasarlo a bytes
        [ "$modo" = binario ] && [ -n "$hash" ] && break
        # 1) El contenido completo en cada formato
        for tipo in "${FORMATOS[@]}"; do
            if intentar "$tipo" "$contenido" "$modo" "$actual"; then
                cp -- "$tmp" "$nuevo"
                agregar_capa "$(describir "$tipo")" "$nuevo"
                return 0
            fi
        done
        # 2) Bloques dentro del texto: en modo texto se juntan todos los mensajes; en binario, el primero
        for bloque in "${bloques[@]}"; do
            for tipo in "${FORMATOS_BLOQUES[@]}"; do
                intentar "$tipo" "$bloque" "$modo" "$actual" || continue
                n=$((n + 1))
                cp -- "$tmp" "$trabajo/parte$n"
                partes+=("$trabajo/parte$n")
                [ -z "$desc" ] && desc="$(describir "$tipo")"
                break
            done
            [ "$modo" = binario ] && [ "$n" -gt 0 ] && break
        done
        [ "$n" -gt 0 ] && break
    done

    if [ "$n" -eq 0 ] && [ -n "$hash" ]; then
        echo "Error: parece un hash $hash (${#contenido} caracteres hexadecimales), no un texto cifrado." >&2
        echo "Un hash no se puede desencriptar: solo se puede crackear (opción c)." >&2
        return 1
    elif [ "$n" -eq 0 ]; then
        echo "Error: no se reconoció ninguna otra capa codificada. Este parece ser el resultado final." >&2
        return 1
    fi
    if [ "$n" -eq 1 ]; then
        cp -- "${partes[0]}" "$nuevo"
        agregar_capa "$desc, bloque dentro del texto" "$nuevo"
    else
        : > "$nuevo"
        for i in "${partes[@]}"; do
            cat -- "$i" >> "$nuevo"
            [ "$(tail -c 1 -- "$i" | xxd -p)" = 0a ] || echo >> "$nuevo"
        done
        agregar_capa "$desc, $n mensajes distintos dentro del texto (uno por línea)" "$nuevo"
    fi
}

# Muestra un resultado binario: tipo, primeros bytes y cadenas legibles
mostrar_binario() {
    local f="$1" tipo=""
    command -v file > /dev/null 2>&1 && tipo=" — $(file -b -- "$f")"
    echo "(Resultado binario: $(wc -c < "$f") bytes$tipo)"
    echo
    echo "Primeros 256 bytes:"
    xxd -l 256 -- "$f"
    echo
    echo "Cadenas legibles (6 o más caracteres):"
    LC_ALL=C grep -aoE '[[:print:]]{6,}' -- "$f" | awk '!visto[$0]++' | head -n 50
}

# Versión en texto de una capa binaria, para guardarla como .txt: volcado hexadecimal completo y cadenas
volcado_binario() {
    local f="$1" salida="$2" tipo=""
    command -v file > /dev/null 2>&1 && tipo=" — $(file -b -- "$f")"
    {
        echo "# Capa $(( ${#CAPA_ARCH[@]} - 1 )): ${CAPA_DESC[${#CAPA_DESC[@]}-1]}"
        echo "# Resultado binario: $(wc -c < "$f") bytes$tipo"
        echo "# Para recuperar los bytes originales:"
        echo "#   grep -E '^[0-9a-f]{8}:' \"$(basename -- "$salida")\" | xxd -r > capa.bin"
        echo
        echo "## Volcado hexadecimal"
        xxd -- "$f"
        echo
        echo "## Cadenas legibles (6 o más caracteres)"
        LC_ALL=C grep -aoE '[[:print:]]{6,}' -- "$f" | awk '!visto[$0]++'
    } > "$salida"
}

# Limpia la pantalla (solo si se está usando en una terminal)
limpiar() {
    [ -t 1 ] && clear
    return 0
}

# Muestra la capa actual y el recorrido hasta ella
mostrar_capa() {
    local ult=$(( ${#CAPA_ARCH[@]} - 1 )) f i
    f="${CAPA_ARCH[ult]}"
    limpiar
    echo "===== Archivo: $archivo ====="
    if [ "$ult" -eq 0 ]; then
        echo "Capa 0: contenido original"
    else
        echo "Capa $ult: ${CAPA_DESC[ult]}"
    fi
    echo "----------------------------------------"
    if es_texto "$f"; then
        cat -- "$f"
        [ "$(tail -c 1 -- "$f" | xxd -p)" = 0a ] || echo
    else
        mostrar_binario "$f"
    fi
    echo "----------------------------------------"
    if [ "$ult" -gt 0 ]; then
        echo "Recorrido ($ult capa(s) descifrada(s)):"
        for ((i = 1; i <= ult; i++)); do echo "  $i. ${CAPA_DESC[i]}"; done
    fi
}

xor_manual() {
    local clave nuevo="$trabajo/capa${#CAPA_ARCH[@]}"
    read -r -p "Clave XOR de un byte (ej: 35 o 0x23): " clave || exit 0
    if ! clave_valida "$clave"; then
        echo "Error: clave inválida (tiene que ser de 0 a 255, en decimal o con 0x)." >&2
        return 1
    fi
    cp -- "${CAPA_ARCH[${#CAPA_ARCH[@]}-1]}" "$nuevo"
    aplicar_xor "$clave" "$nuevo"
    DESCARTADOS=""
    posprocesar "$nuevo" /dev/null
    agregar_capa "$(describir "XOR $clave (manual)")" "$nuevo"
}

# Guarda la capa actual junto al archivo original, siempre como .txt
# (si es binaria, se guarda el volcado hexadecimal y las cadenas legibles)
guardar() {
    local f="${CAPA_ARCH[${#CAPA_ARCH[@]}-1]}" salida r
    if [ "${#CAPA_ARCH[@]}" -eq 1 ]; then
        echo "Nada para guardar: estás viendo el contenido original." >&2
        return
    fi
    salida="$(nombre_salida txt)"
    if [ -e "$salida" ]; then
        read -r -p "'$salida' ya existe. ¿Sobrescribir? [s/N] " r || exit 0
        [[ "$r" =~ ^[sS]$ ]] || { echo "No se guardó."; return; }
    fi
    if es_texto "$f"; then
        cp -- "$f" "$salida" || return
        echo "-> Capa $(( ${#CAPA_ARCH[@]} - 1 )) guardada en: $salida"
    else
        volcado_binario "$f" "$salida" || return
        echo "-> Capa $(( ${#CAPA_ARCH[@]} - 1 )) (binaria) guardada como volcado hexadecimal en: $salida"
    fi
}

# Opción "Ejecutar": descifra la primera capa y deja seguir paso a paso
ejecutar() {
    local op
    CAPA_ARCH=("$trabajo/capa0")
    CAPA_DESC=("contenido original")
    cp -- "$archivo" "$trabajo/capa0"
    if siguiente_capa; then
        mostrar_capa
    elif detectar_hash "$trabajo/capa0"; then
        # Un hash no se desencripta, pero se puede crackear: se queda en la capa 0 para elegir "c"
        echo
        echo "Capa 0: hash $HASH_TIPO"
    else
        echo "Petición rechazada para '$archivo'." >&2
        pausa
        return
    fi
    while true; do
        echo
        echo "d) Desencriptar de nuevo   x) Aplicar XOR   c) Crackear hash   a) Capa anterior   g) Guardar   v) Volver al menú"
        read -r -p "Opción [d]: " op || exit 0
        case "$op" in
            d|D|"") siguiente_capa && mostrar_capa ;;
            x|X) xor_manual && mostrar_capa ;;
            c|C) crackear && mostrar_capa ;;
            a|A)
                if [ "${#CAPA_ARCH[@]}" -gt 1 ]; then
                    unset "CAPA_ARCH[${#CAPA_ARCH[@]}-1]" "CAPA_DESC[${#CAPA_DESC[@]}-1]"
                    mostrar_capa
                else
                    echo "Ya estás en el contenido original." >&2
                fi ;;
            g|G) guardar ;;
            v|V) return ;;
            *) echo "Opción inválida." >&2 ;;
        esac
    done
}

# Espera Enter antes de volver al menú
pausa() {
    echo
    read -r -p "Presione Enter para volver al menú..." _ || exit 0
}

# Archivo inicial: argumento o pregunta
if [ "$#" -ge 1 ] && [ -f "$1" ]; then
    archivo="$1"
else
    [ "$#" -ge 1 ] && echo "Error: el archivo '$1' no existe." >&2
    elegir_archivo
fi

while true; do
    limpiar
    echo "===== Archivo: $archivo ====="
    echo "1) Ejecutar"
    echo "2) Cambiar archivo"
    echo "3) Salir"
    read -r -p "Opción: " opcion || exit 0
    limpiar
    case "$opcion" in
        1) ejecutar ;;
        2) elegir_archivo ;;
        3) echo "Saliendo."; exit 0 ;;
        *) echo "Opción inválida." >&2; pausa ;;
    esac
done
